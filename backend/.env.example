# --- Server ---
PORT=5000
CORS_ORIGINS=http://localhost:5173

# --- Foodoscope (RecipeDB / FlavorDB). Get these from the hackathon organizers. ---
# Leave FOODOSCOPE_API_KEY empty to run on the built-in fallback data.
FOODOSCOPE_API_KEY=
RECIPEDB_BASE_URL=
FLAVORDB_BASE_URL=

# --- Vision (fridge photo + receipt reading) via Claude. Empty = demo fallback. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
